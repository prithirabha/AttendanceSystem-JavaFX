<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" stylesheets="@../css/theme.css" xmlns="http://javafx.com/javafx/" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bsmi.attendancesystem.FirstRunController">
    <children>
        <AnchorPane fx:id="main_form" prefHeight="200.0" prefWidth="200.0">
            <children>
                <AnchorPane prefHeight="400.0" prefWidth="300.0" styleClass="left-form" stylesheets="@../css/login-style.css" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <children>
                        <FontIcon iconLiteral="fas-graduation-cap" iconSize="150" layoutX="56.0" layoutY="214.0" />
                        <Label layoutX="32.0" layoutY="243.0" text="Attendance System" styleClass="text-title" />
                    </children></AnchorPane>
                <AnchorPane layoutX="10.0" layoutY="10.0" prefHeight="400.0" prefWidth="300.0" styleClass="right-form" stylesheets="@../css/login-style.css" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <children>
                        <FontIcon iconLiteral="fas-user-shield" iconSize="80" layoutX="116.0" layoutY="70.0" />
                        <Label layoutX="78.0" layoutY="96.0" text="First-time setup" styleClass="text-heading" />
                        <Label alignment="CENTER" layoutX="22.0" layoutY="120.0" prefWidth="250.0" text="Create the administrator account" textAlignment="CENTER" styleClass="text-caption" />
                        <MFXTextField fx:id="usernameMFXTextField" floatMode="BORDER" floatingText="Username" layoutX="22.0" layoutY="150.0" prefHeight="40.0" prefWidth="250.0" styleClass="mfx-text-field">
                            <cursor>
                                <Cursor fx:constant="TEXT" />
                            </cursor>
                        </MFXTextField>
                        <MFXPasswordField fx:id="passwordMFXPasswordField" floatMode="BORDER" floatingText="Password" layoutX="22.0" layoutY="202.0" prefHeight="40.0" prefWidth="250.0" styleClass="mfx-password-field">
                            <cursor>
                                <Cursor fx:constant="TEXT" />
                            </cursor>
                        </MFXPasswordField>
                        <MFXPasswordField fx:id="confirmPasswordMFXPasswordField" floatMode="BORDER" floatingText="Confirm password" layoutX="22.0" layoutY="254.0" prefHeight="40.0" prefWidth="250.0" styleClass="mfx-password-field">
                            <cursor>
                                <Cursor fx:constant="TEXT" />
                            </cursor>
